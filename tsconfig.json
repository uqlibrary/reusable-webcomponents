{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "paths": {
            "@uq/pw/*": ["./playwright/*"]
        }
    },
    "include": ["playwright.config.ts", "playwright/**/*"]
}
